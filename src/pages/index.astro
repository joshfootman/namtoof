---
import { FallingPages, FallingPagesPage } from "../components/falling-pages";
import { Navbar } from "../components/navbar";
import { Title } from "../components/title";
import "../styles/global.css";
---

<html lang="en" class="scrollbar-gutter-stable scroll-smooth bg-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Footman</title>
  </head>
  <body class="bg-primary font-pixel-secondary">
    <Navbar client:load />
    <FallingPages client:load>
      <FallingPagesPage client:load>
        <div class="flex h-full w-full justify-center">
          <div
            class="relative flex h-fit w-220 flex-col-reverse pt-4 sm:h-auto sm:pt-0 lg:justify-center"
          >
            <div class="z-1 flex flex-col gap-5 pt-8 sm:pt-0">
              <div class="flex flex-col gap-5 lg:absolute lg:top-54 lg:left-0">
                <h2
                  class="@container text-[calc(15.5cqw)] text-nowrap [text-box:trim-both_cap_alphabetic] sm:text-[calc(10cqw)] lg:@container-normal lg:text-8xl"
                >
                  JOSH FOOTMAN
                </h2>
                <p
                  class="@container text-[calc(8cqw)] text-nowrap [text-box:trim-both_cap_alphabetic] before:content-['['] after:content-[']'] sm:text-[calc(5cqw)] lg:@container-normal lg:text-5xl"
                >
                  CREATIVE ENGINEER
                </p>
                <p class="mt-8 text-2xl uppercase">
                  Building quality products for changing user needs
                </p>
                <a
                  href="/JOSH_FOOTMAN_CV.pdf"
                  download
                  class="group inline-flex w-fit cursor-pointer items-center bg-primary px-5 py-4 text-xl uppercase outline-none"
                >
                  <span class="inline-block overflow-hidden leading-none">
                    <span
                      class="inline-block transform-[translateY(0)] text-white opacity-100 transition-[transform,opacity] duration-300 ease-out text-shadow-[0_1em_0] text-shadow-white group-hover:transform-[translateY(-0.92em)] group-focus-visible:transform-[translateY(-0.92em)] before:mr-1 before:opacity-0 before:content-['['] group-hover:before:opacity-100 group-focus-visible:before:opacity-100 after:ml-1 after:opacity-0 after:content-[']'] group-hover:after:opacity-100 group-focus-visible:after:opacity-100 motion-reduce:transform-[translateY(0.08em)] motion-reduce:opacity-100 motion-reduce:transition-none"
                    >
                      download cv
                    </span>
                  </span>
                </a>
              </div>
            </div>
            <img
              src="/me.jpeg"
              width="450"
              class="z-0 sm:absolute sm:top-12 sm:left-1/2 sm:-translate-x-1/2 lg:right-0 lg:left-auto lg:translate-x-0"
            />
          </div>
        </div>
      </FallingPagesPage>
      <FallingPagesPage id="ABOUT" client:load>
        <Title text="ABOUT" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="EXPERIENCE" client:load>
        <Title text="EXPERIENCE" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="PROJECTS" client:load>
        <Title text="PROJECTS" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="LINKS" client:load>
        <Title text="LINKS" client:load />
      </FallingPagesPage>
    </FallingPages>
  </body>
</html>

