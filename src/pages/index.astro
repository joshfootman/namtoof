---
import { CelebrationIcon, MapPinIcon } from "../components/icons";
import { Navbar } from "../components/navbar";
import { RevealElement } from "../components/reveal-element";
import { RotatingRevealText } from "../components/rotating-reveal-text";
import "../styles/global.css";
---

<html
  lang="en"
  class="snap-y snap-mandatory scrollbar-gutter-stable scroll-smooth"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Footman</title>
  </head>
  <body class="bg-background">
    <Navbar client:load />
    <section
      class="flex min-h-dvh w-screen snap-start snap-always items-start justify-center pt-18 font-pixel-primary lg:items-center lg:pt-0"
    >
      <div
        class="flex w-full flex-col-reverse items-center p-8 lg:flex-row lg:items-end lg:px-[10%]"
      >
        <div
          class="flex flex-1 flex-col items-end justify-end px-8 pt-8 lg:mb-20 lg:pt-0"
        >
          <div class="flex flex-col items-end">
            <RevealElement client:load>
              <h2 class="text-5xl text-nowrap md:text-6xl xl:text-7xl">
                JOSH FOOTMAN
              </h2>
            </RevealElement>
            <RotatingRevealText
              client:load
              items={[
                "CREATIVE ENGINEER",
                "SOFTWARE ENGINEER",
                "PRODUCT ENGINEER",
              ]}
              className="font-pixel-secondary text-3xl xl:text-5xl"
            />
          </div>
        </div>
        <div class="flex flex-1 items-center justify-start lg:mb-20">
          <RevealElement client:load>
            <div class="h-110 w-70 border border-foreground md:h-140 md:w-100">
            </div>
          </RevealElement>
        </div>
      </div>
    </section>
    <section
      id="ABOUT"
      class="flex min-h-dvh w-screen snap-start snap-always pb-10"
    >
      <div class="flex flex-1 p-4 pt-20 md:p-8 md:px-[10%] md:pt-24">
        <div class="flex flex-1 flex-col">
          <div class="flex w-full flex-row items-start">
            <h2 class="font-pixel-secondary text-5xl md:text-6xl">ABOUT</h2>
            <div
              class="mt-6 ml-8 flex h-6 flex-1 border-t border-r border-foreground pt-px md:mt-7.5 md:h-7.5"
            >
            </div>
          </div>
          <div
            class="mx-6 flex flex-1 flex-col justify-center gap-14 pb-8 md:mx-8 md:my-2 md:pb-0 lg:pb-4 xl:pb-14"
          >
            <div
              class="flex flex-row items-end gap-4 font-pixel-secondary text-3xl sm:px-8 sm:text-4xl md:px-14 lg:text-5xl"
            >
              <RevealElement client:load>
                <div class="flex flex-row items-center">
                  <span>BASED IN</span>
                  <span class="flex flex-row items-center pl-4 underline">
                    <MapPinIcon
                      client:load
                      className="size-5.5 sm:size-7 lg:size-9"
                    />
                    CARDIFF, UK
                  </span>
                </div>
              </RevealElement>
            </div>
            <div
              class="flex flex-row items-end gap-4 font-pixel-secondary text-3xl sm:px-8 sm:text-4xl md:px-14 lg:text-5xl"
            >
              <RevealElement client:load>
                I'M A FRONTEND ENGINEER DRAWN TO THE SPACE BETWEEN PRODUCT,
                INTERACTION, AND CRAFT — BUILDING USEFUL THINGS THAT FEEL CLEAR,
                CONSIDERED, AND WELL MADE.
              </RevealElement>
            </div>
            <div
              class="flex flex-row items-end gap-4 font-pixel-secondary text-3xl sm:px-8 sm:text-4xl md:px-14 lg:text-5xl"
            >
              <RevealElement client:load>
                <span class="inline-flex items-center underline">
                  <CelebrationIcon
                    className="size-5.5 shrink-0 sm:size-7 lg:size-9"
                  />
                  SOON-TO-BE FATHER.
                </span>
                STILL FIGURING THINGS OUT, BUT TRYING TO MAKE GOOD THINGS WITH GOOD
                PEOPLE.
              </RevealElement>
            </div>
          </div>
          <div class="h-6 border-b border-l border-foreground md:h-7.5"></div>
        </div>
      </div>
    </section>
    <section
      id="EXPERIENCE"
      class="flex min-h-dvh w-screen snap-start snap-always pb-10"
    >
      <div class="flex flex-1 p-4 pt-20 md:p-8 md:px-[10%] md:pt-24">
        <div class="flex flex-1 flex-col">
          <div class="flex w-full flex-row items-start">
            <h2 class="font-pixel-secondary text-5xl md:text-6xl">
              EXPERIENCE
            </h2>
            <div
              class="mt-6 ml-8 flex h-6 flex-1 border-t border-r border-foreground pt-px md:mt-7.5 md:h-7.5"
            >
            </div>
          </div>
          <div class="mx-6 flex-1 md:mx-8 md:my-2"></div>
          <div class="h-6 border-b border-l border-foreground md:h-7.5"></div>
        </div>
      </div>
    </section>
    <section
      id="PROJECTS"
      class="flex min-h-dvh w-screen snap-start snap-always pb-10"
    >
      <div class="flex flex-1 p-4 pt-20 md:p-8 md:px-[10%] md:pt-24">
        <div class="flex flex-1 flex-col">
          <div class="flex w-full flex-row items-start">
            <h2 class="font-pixel-secondary text-5xl md:text-6xl">PROJECTS</h2>
            <div
              class="mt-6 ml-8 flex h-6 flex-1 border-t border-r border-foreground pt-px md:mt-7.5 md:h-7.5"
            >
            </div>
          </div>
          <div class="mx-6 flex-1 md:mx-8 md:my-2"></div>
          <div class="h-6 border-b border-l border-foreground md:h-7.5"></div>
        </div>
      </div>
    </section>
    <section
      id="LINKS"
      class="flex min-h-dvh w-screen snap-start snap-always pb-10"
    >
      <div class="flex flex-1 p-4 pt-20 md:p-8 md:px-[10%] md:pt-24">
        <div class="flex flex-1 flex-col">
          <div class="flex w-full flex-row items-start">
            <h2 class="font-pixel-secondary text-5xl md:text-6xl">LINKS</h2>
            <div
              class="mt-6 ml-8 flex h-6 flex-1 border-t border-r border-foreground pt-px md:mt-7.5 md:h-7.5"
            >
            </div>
          </div>
          <div class="mx-6 flex-1 md:mx-8 md:my-2"></div>
          <div class="h-6 border-b border-l border-foreground md:h-7.5"></div>
        </div>
      </div>
    </section>
  </body>
</html>
