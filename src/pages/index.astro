---
import { Navbar } from "../components/navbar";
import { Title } from "../components/title";
import "../styles/global.css";
---

<html lang="en" class="scrollbar-gutter-stable scroll-smooth bg-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Footman</title>
  </head>
  <body class="bg-primary font-pixel-secondary">
    <Navbar client:load />
    <section
      class="flex h-screen w-full flex-col overflow-hidden border-b border-primary bg-noise px-8 py-[11.25dvh] lg:px-[11.25dvw]"
    >
      <div class="flex h-full w-full justify-center">
        <div class="relative flex h-full w-220 flex-col lg:justify-center">
          <div class="z-1 flex h-full flex-col gap-5 pt-8 sm:pt-0">
            <div
              class="flex h-188 flex-col justify-between gap-5 lg:absolute lg:top-54 lg:left-0 lg:h-auto"
            >
              <div
                class="flex translate-y-[1dvh] flex-col gap-5 sm:translate-y-[4dvh] lg:translate-y-0"
              >
                <h2
                  class="text-7xl text-nowrap [text-box:trim-both_cap_alphabetic] sm:text-8xl"
                >
                  JOSH FOOTMAN
                </h2>
                <p
                  class="text-4xl text-nowrap [text-box:trim-both_cap_alphabetic] before:content-['['] after:content-[']'] sm:text-5xl"
                >
                  CREATIVE ENGINEER
                </p>
              </div>
              <div
                class="flex translate-y-[2.5dvh] flex-col gap-5 lg:mt-8 lg:translate-y-0"
              >
                <p
                  class="-mx-12 bg-secondary px-12 text-2xl uppercase sm:bg-transparent"
                >
                  Building quality products for changing user needs
                </p>
                <a
                  href="/JOSH_FOOTMAN_CV.pdf"
                  download
                  class="group inline-flex w-fit cursor-pointer items-center bg-primary px-5 py-4 text-xl leading-none text-white uppercase outline-none before:mr-1 before:inline-block before:translate-y-[0.08em] before:opacity-0 before:content-['['] after:ml-1 after:inline-block after:translate-y-[0.08em] after:opacity-0 after:content-[']'] hover:before:opacity-100 hover:after:opacity-100 focus-visible:before:opacity-100 focus-visible:after:opacity-100"
                >
                  <span class="inline-block overflow-hidden leading-none">
                    <span
                      class="inline-block transform-[translateY(0)] opacity-100 transition-[transform,opacity] duration-300 ease-out text-shadow-[0_1em_0] text-shadow-white group-hover:transform-[translateY(-0.92em)] group-focus-visible:transform-[translateY(-0.92em)] motion-reduce:transform-[translateY(0.08em)] motion-reduce:opacity-100 motion-reduce:transition-none"
                    >
                      download cv
                    </span>
                  </span>
                </a>
              </div>
            </div>
          </div>
          <img
            src="/me.jpeg"
            width="450"
            class="absolute top-12 left-1/2 z-0 w-112.5 max-w-none -translate-x-1/2 lg:right-0 lg:left-auto lg:translate-x-0"
          />
        </div>
      </div>
    </section>
    <section
      class="flex h-screen w-full flex-col border-b border-primary bg-noise px-8 py-[11.25dvh] lg:px-[11.25dvw]"
    >
      <Title text="ABOUT" client:load />
    </section>

    <section
      class="flex h-screen w-full flex-col border-b border-primary bg-noise px-8 py-[11.25dvh] lg:px-[11.25dvw]"
    >
      <Title text="EXPERIENCE" client:load />
    </section>

    <section
      class="flex h-screen w-full flex-col border-b border-primary bg-noise px-8 py-[11.25dvh] lg:px-[11.25dvw]"
    >
      <Title text="PROJECTS" client:load />
    </section>

    <section
      class="flex h-screen w-full flex-col border-b border-primary bg-noise px-8 py-[11.25dvh] lg:px-[11.25dvw]"
    >
      <Title text="LINKS" client:load />
    </section>
  </body>
</html>
