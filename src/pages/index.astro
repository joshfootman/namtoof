---
import "../styles/global.css";

const seo = {
  title: "Josh Footman",
  description:
    "Personal site for Josh Footman, a software engineer specialising in React, TypeScript, product discovery, front-end architecture, and technical leadership.",
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Josh Footman",
  jobTitle: "Senior Software Engineer",
  description: seo.description,
  email: "mailto:joshjfootman@gmail.com",
  address: { "@type": "PostalAddress", addressCountry: "GB" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Warwick" },
  sameAs: ["https://www.linkedin.com/in/josh-footman-193b10127/"],
  knowsAbout: [
    "Product engineering",
    "Software engineering",
    "React",
    "TypeScript",
    "Java",
    "Front-end architecture",
    "Technical leadership",
  ],
};

const experience = [
  {
    employer: "Lloyds Banking Group",
    timeline: "Jan 2026 — Present",
    description: `
      Share development leadership responsibilities with the technical lead,
      guiding engineers and translating subject-matter expertise into actionable requirements.
      Work with architects and engineering teams to evolve a microservices and
      microfrontend architecture spanning React, TypeScript, Java, and Spring,
      while improving front-end standards and mentoring junior engineers.
    `,
  },
  {
    employer: "IBM",
    timeline: "Jun 2020 — Dec 2025",
    description: `
      Led the complete redesign of a React and TypeScript application,
      selecting its core libraries and working directly with client stakeholders
      to align the product with user needs. Shaped technical direction through
      prototypes and architectural design, ran user workshops, mentored ui engineers,
      and contributed across the stack with GraphQL, Java, Cypher, and Scala.
    `,
  },
  {
    employer: "BAE Systems",
    timeline: "Feb 2019 — Jun 2020",
    description: `
      Worked across the full software development lifecycle on three projects,
      building ERP management tools and assuring the quality of a licence management system.
      Also initiated and developed a React and Node.js mobile proof of concept
      for the UK Ministry of Defence, and introduced Cypress and Jest to improve
      front-end reliability and maintainability.
    `,
  },
];

const projects = [
  {
    title: "Roundtable",
    description:
      "Browser-based CS2 demo viewer with local parsing and 2D tactical replay",
    href: "https://roundtable.namtoof.com",
  },
  {
    title: "Crug Mawr Parc",
    description:
      "Hand-painted WebGPU driving game set in an imaginary Welsh national park",
    href: "https://crug-mawr-parc.namtoof.com",
  },
  {
    title: "Craft",
    description:
      "Exploring what makes interface components feel thoughtful, robust, and reusable",
    href: "https://craft.namtoof.com",
  },
];

const links = [
  {
    href: "https://www.linkedin.com/in/josh-footman-193b10127/",
    title: "LinkedIn",
  },
  { href: "https://github.com/joshfootman", title: "GitHub" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Josh Footman" />
    <meta name="theme-color" content="#f3f1e9" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:locale" content="en_GB" />
    <meta property="profile:first_name" content="Josh" />
    <meta property="profile:last_name" content="Footman" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{seo.title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <main class="min-h-screen bg-noise">
      <div class="p-8 sm:p-24">
        <div class="max-w-185" data-stagger>
          <div>
            <h1 class="font-newsreader text-4xl">Josh Footman</h1>
            <p class="font-newsreader-italic text-xl leading-5">
              Senior Software Engineer
            </p>
          </div>
          <div class="pt-8">
            <p class="font-newsreader">
              Software engineer with over six years of experience building web
              applications, with a particular focus on React and TypeScript.
              Most at home where product thinking and engineering meet:
              understanding what users need, shaping a clear technical
              direction, and turning it into software that feels considered and
              dependable. Alongside hands-on development, lead technical
              discovery, mentor engineers, and help teams raise their
              engineering standards.
            </p>
          </div>
          <div class="pt-12">
            <h2 class="font-newsreader text-2xl">Experience</h2>
            <div class="[&>*:last-child]:pb-0">
              {
                experience.map(({ employer, timeline, description }) => (
                  <div class="py-4 sm:p-4">
                    <div class="flex flex-row items-center justify-between">
                      <h3 class="font-newsreader-italic text-xl">{employer}</h3>
                      <p class="font-newsreader-italic">{timeline}</p>
                    </div>
                    <p class="font-newsreader">{description}</p>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="pt-12">
            <h2 class="font-newsreader text-2xl">Projects</h2>
            <div>
              {
                projects.map(({ title, description, href }) => (
                  <div class="relative rounded-2xl py-4 focus-within:bg-neutral-900/5 hover:bg-neutral-900/5 sm:p-4">
                    <h3 class="font-newsreader-italic text-xl">{title}</h3>
                    <p class="font-newsreader">{description}</p>
                    <a
                      href={href}
                      aria-label={title}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="absolute inset-0" />
                    </a>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="pt-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-0">
              {
                links.map(({ href, title }) => (
                  <a
                    class="font-newsreader-italic text-xl outline-none hover:underline focus-visible:underline sm:not-first:pl-3 sm:not-last:pr-3"
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {title}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </main>
    <script>
      import { gsap } from "gsap";

      const items = document.querySelectorAll(
        "[data-stagger] > :not(:has(h2)), [data-stagger] h2, [data-stagger] h2 + div > *",
      );
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      gsap.fromTo(
        items,
        { autoAlpha: 0, y: reduce ? 0 : 16 },
        {
          autoAlpha: 1,
          y: 0,
          duration: reduce ? 0.3 : 0.8,
          ease: "expo.out",
          stagger: 0.07,
          clearProps: "transform",
        },
      );
    </script>
  </body>
</html>
