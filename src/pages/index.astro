---
import { FallingPages, FallingPagesPage } from "../components/falling-pages";
import { Navbar } from "../components/navbar";
import "../styles/global.css";
---

<html lang="en" class="scrollbar-gutter-stable scroll-smooth bg-black">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Footman</title>
  </head>
  <body class="bg-black font-pixel-secondary">
    <Navbar client:load />
    <FallingPages client:load>
      <FallingPagesPage client:load>
        <div class="flex h-full w-full bg-home"></div>
      </FallingPagesPage>
      <FallingPagesPage id="ABOUT" client:load>
        <div class="flex h-full w-full bg-about">
          <h1>about</h1>
        </div>
      </FallingPagesPage>
      <FallingPagesPage id="EXPERIENCE" client:load>
        <div class="flex h-full w-full bg-experience">
          <h1>experience</h1>
        </div>
      </FallingPagesPage>
      <FallingPagesPage id="PROJECTS" client:load>
        <div class="flex h-full w-full bg-projects">
          <h1>projects</h1>
        </div>
      </FallingPagesPage>
      <FallingPagesPage id="LINKS" client:load>
        <div class="flex h-full w-full bg-links">
          <h1>links</h1>
        </div>
      </FallingPagesPage>
    </FallingPages>
  </body>
</html>
