---
import { FallingPages, FallingPagesPage } from "../components/falling-pages";
import { Navbar } from "../components/navbar";
import { Title } from "../components/title";
import "../styles/global.css";
---

<html lang="en" class="scrollbar-gutter-stable scroll-smooth bg-black">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Josh Footman</title>
  </head>
  <body class="bg-black font-pixel-secondary">
    <Navbar client:load />
    <FallingPages client:load>
      <FallingPagesPage client:load />
      <FallingPagesPage id="ABOUT" client:load>
        <Title text="ABOUT" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="EXPERIENCE" client:load>
        <Title text="EXPERIENCE" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="PROJECTS" client:load>
        <Title text="PROJECTS" client:load />
      </FallingPagesPage>
      <FallingPagesPage id="LINKS" client:load>
        <Title text="LINKS" client:load />
      </FallingPagesPage>
    </FallingPages>
  </body>
</html>
